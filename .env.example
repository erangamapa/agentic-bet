# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Persistence — Neon serverless Postgres
# Get one at https://neon.tech ; use the pooled connection string.
# If unset, the system falls back to an in-memory store (dev only) and logs a warning.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# ---------------------------------------------------------------------------
# LLM providers — at least one required. Fallback order is PRIMARY -> FALLBACK.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=<anthropic-api-key>
OPENAI_API_KEY=<openai-api-key>

# Model ids are provider-prefixed (see src/llm/models.ts).
PRIMARY_MODEL=anthropic:claude-sonnet-5
FALLBACK_MODEL=openai:gpt-4.1
# Cheaper model used for the front-end persona agents (optional).
PERSONA_MODEL=anthropic:claude-sonnet-5

# ---------------------------------------------------------------------------
# Observability — LangSmith
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_PROJECT=agentic-bet
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# On-chain execution
# EXECUTION_MODE:
#   stub     - logs the intent, produces a deterministic fake tx that "confirms" (milestone 1-3)
#   simulate - runs a real eth_call simulation against the RPC, never broadcasts
#   onchain  - signs and broadcasts a real transaction, then waits for receipt
# ---------------------------------------------------------------------------
EXECUTION_MODE=stub
CHAIN_ID=84532
CHAIN_RPC_URL=https://sepolia.base.org
BET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Hot wallet that signs bets placed on behalf of users. NEVER commit a real key.
OPERATOR_PRIVATE_KEY=0x<64-hex-chars>
TX_CONFIRMATIONS=1
TX_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Risk / stake limits enforced by the Bet Placement Agent (server-side, not LLM-side)
# ---------------------------------------------------------------------------
MIN_STAKE=1
MAX_STAKE_PER_BET=250
MAX_STAKE_PER_DAY=1000
MAX_OPEN_BETS=10
MAX_ODDS=25
CONFIRMATION_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Front-ends
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
WEB_API_KEY=<shared-secret-for-the-web-client>
