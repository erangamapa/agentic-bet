{
  "name": "agentic-bet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Social betting multi-agent system with a hard privilege boundary between content analysis and money movement",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "telegram": "tsx src/telegram/index.ts",
    "chat": "tsx src/cli/chat.ts",
    "verify:boundary": "LOG_LEVEL=silent tsx src/cli/verify-boundary.ts",
    "verify:db": "LOG_LEVEL=silent tsx src/cli/verify-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "langchain": "^1.5.4",
    "langsmith": "^0.8.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.2",
    "viem": "^2.55.10",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
